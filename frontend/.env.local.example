# Public (browser)
NEXT_PUBLIC_CHAIN_ID=1301                     # 31337 / 31338 for local anvil stacks
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=         # cloud.reown.com; injected wallets work without it
NEXT_PUBLIC_UNICHAIN_RPC_URL=                 # optional, defaults to https://sepolia.unichain.org
NEXT_PUBLIC_AI_API_URL=                       # optional, live AI engine (https)
NEXT_PUBLIC_RPC_URL=                          # local anvil only

# Server only (Vercel env, never NEXT_PUBLIC)
CRON_SECRET=                                  # protects /api/keeper
KEEPER_PRIVATE_KEY=                           # rebalances + harvests
MIRROR_PRIVATE_KEY=                           # keeps the pool tracking real ETH
KEEPER_RPC_URL=                               # optional private RPC for keeper/logs
BLOCKSCOUT_API_KEY=                           # optional, higher explorer limits
